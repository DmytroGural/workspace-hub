{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!**/dist", "!!**/node_modules"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "domains": {
      "vue": "all"
    },
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noAutofocus": "warn",
        "noLabelWithoutControl": "warn",
        "noStaticElementInteractions": "warn",
        "useAltText": "warn",
        "useButtonType": "warn",
        "useKeyWithClickEvents": "warn",
        "useSemanticElements": "off"
      },
      "nursery": {
        "noVueUnusedRefs": "error",
        "noVueUselessVBind": "error",
        "useVueBlockOrder": {
          "level": "error",
          "options": {
            "order": ["script", "template", "style"]
          }
        }
      },
      "performance": {
        "useVueVapor": "off"
      },
      "style": {
        "noVueOptionsApi": "error",
        "useVueDefineMacrosOrder": {
          "level": "error",
          "options": {
            "order": ["defineOptions", "defineProps", "defineEmits", "defineSlots"]
          }
        },
        "useVueMultiWordComponentNames": "off"
      },
      "suspicious": {
        "noConsole": "warn",
        "noDebugger": "warn",
        "noUnknownAtRules": {
          "level": "error",
          "options": {
            "ignore": ["tailwind", "apply", "layer", "variants", "responsive", "screen"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
